{
  "cleanupPeriodDays": 9999,
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "claude-plugins-official": {
      "source": {
        "repo": "anthropics/claude-plugins-official",
        "source": "github"
      }
    }
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.anthropic.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebSearch"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(brew install *)",
      "Bash(cat /etc/shadow*)",
      "Bash(chmod 777 *)",
      "Bash(curl *)",
      "Bash(env *)",
      "Bash(gh repo delete *)",
      "Bash(git clean *)",
      "Bash(git config *)",
      "Bash(git push --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(nc *)",
      "Bash(ncat *)",
      "Bash(netcat *)",
      "Bash(node -e *)",
      "Bash(npm publish *)",
      "Bash(perl -e *)",
      "Bash(printenv *)",
      "Bash(python -c *)",
      "Bash(python3 -c *)",
      "Bash(reboot*)",
      "Bash(rm -fr *)",
      "Bash(rm -r -f *)",
      "Bash(rm -rf *)",
      "Bash(ruby -e *)",
      "Bash(shutdown *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(wget *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.ssh/**)",
      "Read(~/.bashrc)",
      "Read(~/.zshrc)"
    ]
  },
  "statusLine": {
    "command": "bash ~/dotfiles/claude/statusline.sh",
    "type": "command"
  }
}
