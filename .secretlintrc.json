{
  "rules": [
    {
      "id": "@secretlint/secretlint-rule-preset-recommend"
    },
    {
      "id": "@secretlint/secretlint-rule-pattern",
      "options": {
        "patterns": [
          {
            "name": "e-mail address",
            "patterns": ["/[\\w.+-]+@[\\w-]+(\\.[\\w-]+)*\\.[a-z]{2,}\\b/i"],
            "allows": [
              "/@(example\\.(com|org|net)|users\\.noreply\\.github\\.com)$/i",
              "/@[\\w.-]+\\.(test|invalid)$/i",
              "/^allowlockedremotedesktop@kamens\\.us$/",
              "/^x@y\\.com$/"
            ]
          },
          {
            "name": "home directory with a user name",
            "patterns": [
              "/(?<![\\w.~-])\\/Users\\/(?!Shared\\b)[\\w.-]+/",
              "/(?<![\\w.~-])\\/home\\/(?!(tester|username|linuxbrew)\\b)[\\w.-]+/"
            ]
          },
          {
            "name": "private IPv4 address",
            "patterns": [
              "/\\b(10\\.\\d+|192\\.168|172\\.(1[6-9]|2\\d|3[01]))\\.\\d+\\.\\d+\\b/"
            ]
          },
          {
            "name": "tailnet host name",
            "patterns": ["/\\b[\\w-]+\\.[\\w-]+\\.ts\\.net\\b/i"]
          }
        ]
      }
    }
  ]
}
