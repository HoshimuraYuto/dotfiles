# These are argument prefixes, not Claude's shell-string wildcard patterns.
prefix_rule(pattern = ["brew", "install"], decision = "forbidden")
prefix_rule(pattern = ["cat", "/etc/shadow"], decision = "forbidden")
prefix_rule(pattern = ["chmod", "777"], decision = "forbidden")
prefix_rule(pattern = [["curl", "wget", "env", "printenv"]], decision = "forbidden")
prefix_rule(pattern = ["gh", "repo", "delete"], decision = "forbidden")
prefix_rule(pattern = ["git", ["clean", "config"]], decision = "forbidden")
prefix_rule(pattern = ["git", "push", ["--force", "--force-with-lease", "-f"]], decision = "forbidden")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden")
prefix_rule(pattern = [["kill", "killall", "nc", "ncat", "netcat"]], decision = "forbidden")
prefix_rule(pattern = [["node", "perl", "ruby"], "-e"], decision = "forbidden")
prefix_rule(pattern = [["python", "python3"], "-c"], decision = "forbidden")
prefix_rule(pattern = ["npm", "publish"], decision = "forbidden")
prefix_rule(pattern = [["reboot", "shutdown", "su", "sudo"]], decision = "forbidden")
prefix_rule(pattern = ["rm", ["-fr", "-rf"]], decision = "forbidden")
prefix_rule(pattern = ["rm", "-r", "-f"], decision = "forbidden")
