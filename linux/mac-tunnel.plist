<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by dotfiles/linux/mac-tunnel.sh from linux/mac-tunnel.plist -->
<!-- launchd listens on localhost and starts one ssh per connection; nothing runs in between -->
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>@SSH_CONFIG@
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-W</string><string>localhost:@PORT@</string>
    <string>@HOST@</string>
  </array>
  <key>inetdCompatibility</key><dict><key>Wait</key><false/></dict>
  <key>Sockets</key>
  <dict>
    <key>Listener</key>
    <dict>
      <key>SockNodeName</key><string>127.0.0.1</string>
      <key>SockServiceName</key><string>@LOCAL_PORT@</string>
    </dict>
  </dict>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- An agent does not inherit the installer's HOME -->
    <key>HOME</key><string>@HOME@</string>
  </dict>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/@LABEL@.log</string>
</dict>
</plist>
