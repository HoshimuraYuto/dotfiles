// Managed by dotfiles linux/install.sh
// A VNC session is not a local active session, so colord asks for a password
// whenever it registers the virtual screen. Allow it for administrators only.
polkit.addRule(function (action, subject) {
  if (
    /^org\.freedesktop\.color-manager\.(create|delete|modify)-(device|profile)$/.test(action.id) &&
    subject.isInGroup("sudo")
  ) {
    return polkit.Result.YES;
  }
});
